---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>我们的咪 · Our Cats Live Forever</title>
  </head>
  <body>
    <header class="hero">
      <h1>🐱 我们的咪</h1>
      <p class="subtitle">让咪获得赛博永生！</p>
      <a class="cta" href="https://github.com/z-orzi/OurCatsLiveForever/blob/main/AI_UPLOAD_GUIDE.md" target="_blank">
        ✏️ 分享我和小猫的故事
      </a>
      <div class="lang-switch">
        <a href={`${base}/en/`}>English</a>
      </div>
    </header>

    <main class="grid">
      {stories.map((s) => (
        <a
          class="card"
          href={`${base}/${s.id}/`}
          title={`${s.data.title} · ${s.data.author}`}
          aria-label={`阅读故事：${s.data.title}`}
        >
          <img
            src={s.data.cover ? `${base}${s.data.cover}` : `${base}/images/default-cover.svg`}
            alt={s.data.title}
            loading="lazy"
          />
        </a>
      ))}
    </main>

    <script is:inline>
      // 随机轮换：每次访问随机打乱卡片顺序；故事超过 MAX 篇时，每次只随机展示其中 MAX 张
      (function () {
        var MAX = 24;
        var grid = document.querySelector('.grid');
        if (!grid) return;
        var cards = Array.prototype.slice.call(grid.children);
        for (var i = cards.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = cards[i]; cards[i] = cards[j]; cards[j] = tmp;
        }
        cards.forEach(function (card, idx) {
          grid.appendChild(card);
          card.style.display = idx < MAX ? '' : 'none';
        });
      })();
    </script>

    <footer>
      <p>我们的咪，在这里永远活着 · <a href="https://github.com/z-orzi/OurCatsLiveForever">在 GitHub 上参与</a></p>
    </footer>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
        background: #fdf6ec;
        color: #4a3b32;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .hero { text-align: center; padding: 64px 20px 40px; }
      .hero h1 { font-size: 2.4rem; letter-spacing: 2px; }
      .subtitle { margin-top: 12px; color: #9a8578; font-size: 1.05rem; }
      .cta {
        display: inline-block; margin-top: 24px; padding: 12px 28px;
        background: #ff8c42; color: #fff; border-radius: 999px;
        text-decoration: none; font-weight: 600; transition: transform .15s;
      }
      .cta:hover { transform: scale(1.05); }
      .lang-switch { margin-top: 14px; }
      .lang-switch a {
        display: inline-block; padding: 6px 20px;
        border: 1px solid #ffd9b8; border-radius: 999px;
        color: #ff8c42; text-decoration: none; font-size: .88rem;
        transition: background .15s;
      }
      .lang-switch a:hover { background: #fff2e5; }
      .grid {
        flex: 1;
        display: grid; gap: 14px;
        grid-template-columns: repeat(auto-fill, 64px);
        justify-content: center;
        max-width: 1100px; width: 100%; margin: 0 auto; padding: 20px 24px 64px;
      }
      .card {
        width: 64px; height: 64px;
        border-radius: 14px; overflow: hidden;
        background: #f3e6d8;
        text-decoration: none; color: inherit;
        box-shadow: 0 4px 16px rgba(120, 85, 50, .10);
        transition: transform .18s, box-shadow .18s;
      }
      .card:hover { transform: translateY(-4px) scale(1.08); box-shadow: 0 10px 22px rgba(120, 85, 50, .22); }
      .card img { width: 100%; height: 100%; object-fit: cover; display: block; }
      footer { text-align: center; padding: 28px 16px; color: #b09a89; font-size: .85rem; }
      footer a { color: #ff8c42; }
    </style>
  </body>
</html>
